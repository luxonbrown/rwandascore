# ---------------------------------------------------------------------------
# RwandaScore API environment
# Copy this file to .env and replace every secret before deploying.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# MySQL 8 / MariaDB connection string
DATABASE_URL="mysql://root:root@127.0.0.1:3306/rwandascore"

# Browser origin allowed by CORS (comma separated for more than one)
FRONTEND_URL="http://localhost:5173"

# Absolute base used to build uploaded-file URLs
PUBLIC_BASE_URL="http://localhost:4000"

# JWT secrets: use at least 32 random characters in production
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Password hashing cost
BCRYPT_ROUNDS=10

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=2097152

# Base seed administrator (npm run seed)
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL="admin@rwandascore.rw"
SEED_ADMIN_PASSWORD="Admin@12345"
